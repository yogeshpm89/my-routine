rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Per-user subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Templates collection
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      // Occurrence overrides collection
      match /overrides/{overrideId} {
        allow read, write: if isOwner(userId);
      }

      // Activity execution logs collection
      match /logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Goals collection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // Life goals collection
      match /life_goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // Day Routine Templates collection
      match /day_templates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      // Weekly Planner configuration collection
      match /weekly_planner/{plannerId} {
        allow read, write: if isOwner(userId);
      }

      // Goal Progress Entries collection
      match /goal_progress/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Notification preferences
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Device notification registry
      match /registry/{registryId} {
        allow read, write: if isOwner(userId);
      }

      // AI routine action configurations
      match /ai_actions/{actionId} {
        allow read, write: if isOwner(userId);
      }

      // AI executions history
      match /ai_executions/{executionId} {
        allow read, write: if isOwner(userId);
      }

      // AI execution formatted results
      match /ai_results/{resultId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
